<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The main content view: brand bar (takes the status-bar inset) above the mode screens -->

    <LinearLayout
        android:id="@+id/mainView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tt_black"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tt_red"
            android:elevation="4dp"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/Theme.Tttheme.Widget"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:titleTextColor="@android:color/white" />

        <FrameLayout
            android:id="@+id/contentHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tt_black" />

            <include
                android:id="@+id/status"
                layout="@layout/status_bar" />

            <include
                android:id="@+id/dialPad"
                layout="@layout/dial_pad"
                android:visibility="gone" />

            <include
                android:id="@+id/warningMessage"
                layout="@layout/warning_message"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- The navigation drawer -->

    <ExpandableListView
        android:id="@+id/left_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/white"
        android:choiceMode="singleChoice"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:groupIndicator="@null" />

</androidx.drawerlayout.widget.DrawerLayout>
